NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind3Y3dud2xtdWRnb21temhwdG53Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4NDA0NjksImV4cCI6MjEwMTQxNjQ2OX0.hGeo7OSQf3WYdgxqyEDkTWpe9rOxJPqLpzD5-rOCL68

# Service role key — Supabase project settings → API → service_role (secret).
# Required for /api/cron/weekly-summary, which reads/writes across every
# user's data on a schedule with no logged-in session to authorize it via
# normal RLS. NEVER expose this to the client — no NEXT_PUBLIC_ prefix, and
# it must only ever be imported from src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — used to send the weekly summary email.
# Get an API key from the Resend dashboard after verifying a sending domain
# (or use their default onboarding@resend.dev sender for testing).
RESEND_API_KEY=
# Optional — defaults to "ZTE Tracker <onboarding@resend.dev>" if unset.
# Set this to a "Name <you@yourdomain.com>" address once you've verified a
# domain in Resend, so the email isn't sent from Resend's own test domain.
WEEKLY_SUMMARY_FROM_EMAIL=

# A random secret string YOU generate (e.g. `openssl rand -hex 32`) — the
# external cron pinger (see README) sends this as a Bearer token so random
# internet traffic can't trigger the weekly email send.
CRON_SECRET=
